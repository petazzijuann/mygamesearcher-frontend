# Dirección de la API del backend. La app la llama directo (el backend tiene que
# permitir este frontend en su CORS: variable FRONTEND_URL del backend).
# En desarrollo, el backend local. En Vercel se carga en Settings > Environment Variables
# con la URL del backend publicado, sin barra al final (por ejemplo https://mi-backend.vercel.app).
VITE_API_URL=http://localhost:3000
